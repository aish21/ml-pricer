FROM python:3.11-slim

LABEL org.opencontainers.image.source="https://github.com/aish21/ml-pricer"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /srv/app

RUN adduser --disabled-password --gecos "" appuser

COPY pyproject.toml README.md ./
COPY app ./app
COPY src ./src
COPY final/research_candidates ./final/research_candidates

# The validated API installs its pricing and market-data dependencies only.
# Training libraries remain deliberately excluded from this image.
RUN python -m pip install --upgrade pip \
    && python -m pip install ".[api]"

RUN mkdir -p /srv/app/data /srv/app/final/results \
    && chown -R appuser:appuser /srv/app

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=2)"

CMD ["uvicorn", "app.backend:app", "--host", "0.0.0.0", "--port", "8000"]
