FROM python:3.14-slim

LABEL org.opencontainers.image.source="https://github.com/aish21/ml-pricer"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /srv/app

RUN adduser --disabled-password --gecos "" streamuser

COPY pyproject.toml README.md ./
COPY app ./app
COPY src ./src
COPY .streamlit ./.streamlit

RUN python -m pip install --upgrade pip \
    && python -m pip install ".[frontend]"

RUN chown -R streamuser:streamuser /srv/app

USER streamuser

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=2)"

CMD ["streamlit", "run", "app/frontend.py", "--server.port", "8501", "--server.address", "0.0.0.0"]
